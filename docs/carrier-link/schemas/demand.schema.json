{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ONEMS Carrier Link - Demanda (schema_version 1.1)",
  "description": "Una demanda tal como la devuelve GET /demands (elemento de demands[]). Los consumidores DEBEN ignorar propiedades desconocidas (compatibilidad hacia delante).",
  "type": "object",
  "required": ["schema_version", "demand_id", "carrier", "products", "include_all_scans", "schedule", "strata"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.1", "description": "Versión del formato de la demanda." },
    "demand_id": { "type": "string", "format": "uuid", "description": "Identificador de la demanda; se devuelve tal cual en el lote." },
    "carrier": { "type": "string", "description": "Código del carrier en ONEMS." },
    "products": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string" },
      "description": "Códigos de producto/servicio del carrier que equivalen al producto medido."
    },
    "include_all_scans": { "type": "boolean", "description": "true: devolver todas las lecturas de los candidatos." },
    "schedule": { "$ref": "#/$defs/Schedule" },
    "strata": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Stratum" } }
  },
  "$defs": {
    "Schedule": {
      "type": "object",
      "required": ["days", "hour", "timezone"],
      "properties": {
        "days": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 7 },
          "description": "Días ISO de emisión: 1 = lunes ... 7 = domingo."
        },
        "hour": { "type": "integer", "minimum": 0, "maximum": 23, "description": "Hora local de emisión." },
        "timezone": { "type": "string", "minLength": 1, "description": "Zona horaria IANA del calendario." }
      }
    },
    "Stratum": {
      "type": "object",
      "required": ["stratum_id", "period", "start_points", "end_points", "samples_required", "candidates_requested"],
      "properties": {
        "stratum_id": { "type": "string", "format": "uuid" },
        "period": { "$ref": "#/$defs/Period" },
        "start_points": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Point" } },
        "end_points": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Point" } },
        "samples_required": { "type": "integer", "minimum": 1 },
        "candidates_requested": { "type": "integer", "minimum": 1, "description": "Mayor o igual que samples_required." }
      }
    },
    "Period": {
      "type": "object",
      "required": ["start", "end", "iso_week"],
      "properties": {
        "start": { "type": "string", "format": "date", "description": "Primer día (incluido), YYYY-MM-DD." },
        "end": { "type": "string", "format": "date", "description": "Último día (incluido), YYYY-MM-DD." },
        "iso_week": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" }
      }
    },
    "Point": {
      "type": "object",
      "required": ["place_ref", "mode_ref"],
      "properties": {
        "place_ref": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Código de lugar del carrier." },
        "mode_ref": { "type": ["string", "null"], "maxLength": 200, "description": "Código de evento del carrier; null = cualquier evento en el lugar." }
      }
    }
  }
}
