                      "typeVersion":  1,
                      "position":  [
                                       524,
                                       -52
                                   ],
                      "parameters":  {
                                         "content":  "## ? Execute Workflow\n\nCalls **Parcels to send** (`Tm2yrywGUDq0PEj3`) once per panelist.\n\n**Inputs passed:**\n- `telegram_id` - panelist\u0027s Telegram ID\n- `panelist_language` - for message localization (es/en/fr/ar)\n\n**Mode:** Run once for each item\n(one execution per panelist)",
                                         "height":  200,
                                         "width":  300,
                                         "color":  7
                                     }
                  },
                  {
                      "id":  "send-list-auto-001",
                      "name":  "Send parcel list",
                      "type":  "n8n-nodes-base.telegram",
                      "typeVersion":  1.2,
                      "position":  [
                                       768,
                                       128
                                   ],
                      "parameters":  {
                                         "chatId":  "={{ $json.telegram_id }}",
                                         "text":  "={{ (() =\u003e {const lang = $json.panelist_language || \"en\";const parcels = JSON.parse($json.response);const h={en:\"\\ud83d\\udce6 *Parcels to send*\",es:\"\\ud83d\\udce6 *Paquetes a enviar*\",fr:\"\\ud83d\\udce6 *Colis \\u00e0 envoyer*\",ar:\"\\ud83d\\udce6 *\\u0627\\u0644\\u0637\\u0631\\u0648\\u062f \\u0644\\u0644\\u0625\\u0631\\u0633\\u0627\\u0644*\"};const f={en:\"Reply with the number to select a parcel and declare the shipment.\",es:\"Responde con el n\\u00famero para seleccionar un paquete y declarar el env\\u00edo.\",fr:\"R\\u00e9pondez avec le num\\u00e9ro pour s\\u00e9lectionner un colis.\",ar:\"\\u0631\\u062f \\u0628\\u0627\\u0644\\u0631\\u0642\\u0645 \\u0644\\u0627\\u062e\\u062a\\u064a\\u0627\\u0631 \\u0637\\u0631\\u062f.\"};let msg=(h[lang]||h[\"en\"])+\"\\n\\n\";parcels.forEach((p,i)=\u003e{msg+=\"*\"+(i+1)+\".* *\"+p.destination_panelist_name+\"* - \"+p.destination_city+\"\\n\\ud83d\\udcc5 \"+p.scheduled_date+\" | \"+p.carrier_name+\"\\n\\n\";});msg+=f[lang]||f[\"en\"];return msg;})() }}",
