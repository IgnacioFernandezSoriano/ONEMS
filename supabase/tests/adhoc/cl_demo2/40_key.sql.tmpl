-- Carrier Link DEMO2 synthetic test, phase "setup" step d (WRITES; template).
-- run.sh generates the key locally (onems_ + 48 hex), keeps it ONLY in the git-ignored out/carrier_key.txt, and renders
-- this template to out/40_key.sql with the sha256 hex and the first 12 characters. The key itself never reaches SQL.
-- (api_key_issue is not used: it refuses the CLI role, which is neither superadmin nor upu_account_manager.)
-- Idempotent: a previous key of this test for the feed is deleted first (its api_usage_log rows cascade).
-- Expires in 30 days, scope carrier_feed, bound to the test connector (the Edge Function reads the feed from the key).
DO $$
BEGIN
  IF (SELECT slug FROM public.accounts WHERE id = 'f4d823d2-93e6-4755-9a89-9da87e7fa86e') IS DISTINCT FROM 'DEMO2'
     OR NOT EXISTS (SELECT 1 FROM public.cl_feeds WHERE id = 'c1de2000-0000-4000-8000-0000000000f1') THEN
    RAISE EXCEPTION 'GUARD: DEMO2 / test connector not found';
  END IF;
  IF '__KEY_HASH__' !~ '^[0-9a-f]{64}$' OR '__KEY_PREFIX__' !~ '^onems_[0-9a-f]{6}$' THEN
    RAISE EXCEPTION 'GUARD: template not rendered';
  END IF;
  DELETE FROM public.api_keys
   WHERE account_id = 'f4d823d2-93e6-4755-9a89-9da87e7fa86e' AND feed_id = 'c1de2000-0000-4000-8000-0000000000f1'
     AND name = 'Carrier Link DEMO (synthetic test)';
  INSERT INTO public.api_keys (account_id, key_hash, key_prefix, name, scope, feed_id, expires_at, is_active)
  VALUES ('f4d823d2-93e6-4755-9a89-9da87e7fa86e', '__KEY_HASH__', '__KEY_PREFIX__', 'Carrier Link DEMO (synthetic test)',
          'carrier_feed', 'c1de2000-0000-4000-8000-0000000000f1', now() + interval '30 days', true);
END $$;

SELECT key_prefix, name, scope, feed_id, is_active, expires_at
  FROM public.api_keys
 WHERE feed_id = 'c1de2000-0000-4000-8000-0000000000f1';
